#!/usr/bin/env bash
# Install (or re-install) this component into an avatar.
#
#   scripts/install <avatar-dir> [--dry-run]
#
# Re-runnable: it is also how an avatar picks up a fixed component, and how one
# carrying the old Go-container copy is upgraded.
set -euo pipefail

SRC="$(cd "$(dirname "$0")/.." && pwd)"
AV="${1:?usage: install <avatar-dir> [--dry-run]}"
DRY=0; [[ "${2:-}" == "--dry-run" ]] && DRY=1
[[ -d "$AV/harness" ]] || { echo "install: no harness/ in $AV -- is this an avatar?" >&2; exit 1; }

run() { (( DRY )) && { echo "  $*"; return; }; "$@"; }

# Replace a file by rename, never by overwriting it in place. A running watcher
# is a bash process reading `mailbox` as it goes: `cp` onto the same inode hands
# it half-old, half-new bytes. A temp file beside the target (same filesystem,
# so the mv is a rename) gives the new copy a new inode; the old one lives on
# for whoever still has it open. The temp name must not exist yet: cp onto an
# existing file keeps that file's mode, and mktemp's is 0600.
put() { # <src> <dst>
    local tmp="$2.install.$$"
    run cp "$1" "$tmp"
    run mv -f "$tmp" "$2"
}

# The v1 container's files. An avatar that still has them would otherwise keep a
# compose file a harness folds into the agent's own stack -- the boot blocker this
# component was rebuilt to remove.
for stale in mailbox.compose.yml mailboxctl config Dockerfile go.mod go.sum cli \
             main.go mailbox.go store.go api.go relay.go identity.go config.go util.go; do
    [[ -e "$AV/tools/nostr-mailbox/$stale" ]] && run rm -rf "$AV/tools/nostr-mailbox/$stale"
done

run mkdir -p "$AV/tools/nostr-mailbox"
put "$SRC/mailbox" "$AV/tools/nostr-mailbox/mailbox"
for sk in "$SRC/skills"/*/; do
    sk="$(basename "$sk")"
    run mkdir -p "$AV/skills/$sk"
    put "$SRC/skills/$sk/SKILL.md" "$AV/skills/$sk/SKILL.md"
done

# registry.json is per-avatar and generated (scripts/build-registry); never clobber
# one that is already there.
if [[ -f "$AV/tools/nostr-mailbox/registry.json" ]]; then
    echo "  registry.json present, left alone"
elif [[ -f "$SRC/registry.json" ]]; then
    put "$SRC/registry.json" "$AV/tools/nostr-mailbox/registry.json"
else
    echo "  NOTE: no registry.json -- generate one: scripts/build-registry <avatar...> > $AV/tools/nostr-mailbox/registry.json"
fi

# The symlink is resolved INSIDE the container, so it must point at the container
# path (/project/...), never at wherever this repo happens to sit on the host.
#
# Iterate the HARNESSES, not directories that happen to exist already. This has
# now been the same bug twice, at two different levels:
#
#   1. Keying off .local/bin meant a harness that had never had one was skipped
#      in silence -- claude only qualified because claude itself installs there
#      -- so `mailbox` was never linked for opencode.
#   2. Keying off home/ has the same shape: home/ only appears once a harness
#      has been STARTED, so an avatar with a harness that is installed but never
#      launched links one harness and passes over the other, again in silence.
#      Found on a live avatar whose opencode harness had never run.
#
# So the test is entrypoint.sh, which exists from the moment the harness is
# synced and does not depend on anything having run. It still correctly excludes
# harness/core and harness/config, which are not harnesses.
for h in "$AV"/harness/*; do
    [[ -f "$h/entrypoint.sh" ]] || continue
    run mkdir -p "$h/home/.local/bin"
    run ln -sfn /project/tools/nostr-mailbox/mailbox "$h/home/.local/bin/mailbox"
    echo "  linked $(basename "$h"):  mailbox"
done
# skills/ needs no link: register-skills symlinks it into each harness at boot.

grep -q 'NOSTR_MAILBOX_NSEC' "$AV/harness/config" 2>/dev/null \
    || echo "  TODO: add \"NOSTR_MAILBOX_NSEC=pass:nunet/avatars/<avatar>/nostr-nsec\" to SANDBOX_SECRETS in $AV/harness/config"
grep -q 'MAILBOX_API_TOKEN' "$AV/harness/config" 2>/dev/null \
    && echo "  TODO: remove MAILBOX_API_TOKEN from $AV/harness/config -- it guards nothing now"

# Body files for `mailbox send --body-file` live in the avatar's tmp/ and must
# never be committed. Make the .gitignore say so: existing avatars repair
# themselves here on re-install, new ones are born with it via the scaffold.
if [[ -f "$AV/.gitignore" ]] && grep -qE '^/?tmp/?$' "$AV/.gitignore"; then
    echo "  tmp/ already gitignored"
elif (( DRY )); then
    echo "  append 'tmp/' to $AV/.gitignore"
else
    printf '\n# mailbox --body-file scratch (ephemeral, never commit)\ntmp/\n' >> "$AV/.gitignore"
    echo "  gitignored tmp/ in $AV/.gitignore"
fi

echo "install: done$( (( DRY )) && echo ' (dry run)'). Next: git add + commit in the avatar, then \`mailbox doctor\` inside it."
