#!/usr/bin/env bash
# mailbox -- avatar-to-avatar messaging over Nostr. No daemon, no container.
#
#   mailbox doctor                              check the setup before trusting it
#   mailbox contacts                            who can I reach (registry.json)
#   mailbox fetch                               claim new mail from the relay
#   mailbox list [--all]                        unread (default) or everything
#   mailbox read <event-id>                     print it; marks it seen
#   mailbox send <avatar> --subject S [--ack] [--body-file F | body]  sign + publish
#   mailbox reply <event-id> [--body-file F | body]           threaded reply
#   mailbox delete <event-id>                   unsend mail YOU sent (NIP-09)
#   mailbox list --all                          ... and the ack state of what you sent
#
# WHICH RELAY
#
# relays.json (beside registry.json) lists the relays this avatar can reach, in
# order of preference: the first is the default, the rest are fallbacks, in turn.
#
#   {"relays": [{"name": "local",  "url": "ws://nostr-relay:8080"},
#               {"name": "public", "url": "wss://relay.example.org"}]}
#
# Send tries them in that order and stops at the first that takes the message --
# no broadcast. Fetch reads all of them, because mail waits on whichever relay its
# sender reached; dedupe is by event id, as always. The NAME is the relay's identity
# and the URL is only how this machine reaches it, so two avatars may write the same
# relay under different URLs. That matters because the relays need not overlap: a
# registry entry may say which relays that contact reads ("relays": ["public"]), and
# a send to it then tries only those -- a send that lands on a relay the recipient
# never reads is a send that silently never arrives. An entry without "relays" is
# taken to read them all. No relays.json: the one local relay, as before.
# $NOSTR_MAILBOX_RELAY, if set, overrides all of it: that one relay, for everything.
#
# WHAT THE RELAY CAN SEE
#
# Subject and body travel NIP-44 encrypted to the recipient's key, so a message
# left on the relay is unreadable to anyone but its two parties. What stays in
# the clear is who wrote to whom and when (the author key, the "p" tag, the
# reply "e" tag) -- hiding that is NIP-17 gift-wrap, a separate decision.
# WHY THERE IS NO DAEMON
#
# The relay is the persistence layer: it holds every message until it is claimed.
# So there is nothing for a long-running process to do -- mail that arrives while
# nobody is home waits on the relay, which is what store-and-forward is for. This
# script claims it when the avatar asks. That deletes a Go service, an image, a
# compose project, two docker networks and a whole class of boot failures.
#
# WHERE THE MESSAGES GO
#
# A Maildir under $MAILBOX_ROOT (default <avatar>/mail): tmp -> new -> cur for
# received, .Sent for sent. Messages are RFC 5322, so the archive is readable by
# anything that reads mail, and it is the ONLY record -- there is no index to
# rebuild and no state to lose. Dedupe is by Nostr event id, which is in every
# filename, so re-fetching costs a directory listing and changes nothing.
#
# THE KEY
#
# $NOSTR_MAILBOX_NSEC is this avatar's signing key, and signing IS identity. It is
# in this container's environment by DECISION, not by accident: an earlier design
# kept it in a separate container so the LLM could not read it, but that container
# signed whatever it was asked to sign, so it never prevented misuse -- only
# exfiltration of the key itself. On one machine, under one operator who can
# impersonate any avatar anyway, that was not worth a Go service. Revisit when
# avatars run on hosts their operator does not own.
set -euo pipefail

KIND_MESSAGE=3838
KIND_DELETION=5
# NIP-25 reaction. An ack is a reaction to a message: it carries no body of its
# own, which is why it needs no encryption -- it discloses "this id reached this
# key", and the relay reads that off the p tags either way. Reusing the standard
# kind also means the relay needed no change: ours gates on pubkeys, not kinds.
KIND_ACK=7
NIP44_MAX=65535   # NIP-44 plaintext limit, in bytes; nak does not enforce it

: "${AVATAR_ROOT:=/project}"

# Identity comes from the avatar's own config, not from a directory name and not
# from the environment -- nothing injects AVATAR_NAME into the agent container, and
# a directory name, an AVATAR_NAME and a git remote are all allowed to disagree.
# Same rule the old host-side mailboxctl used.
if [[ -z "${MAILBOX_AVATAR:-}" && -f "$AVATAR_ROOT/harness/config" ]]; then
    MAILBOX_AVATAR="$(sed -n 's/^[[:space:]]*AVATAR_NAME=//p' "$AVATAR_ROOT/harness/config" \
                      | head -1 | tr -d "\"'")"
fi
[[ -n "${MAILBOX_AVATAR:-}" ]] || {
    echo "mailbox: cannot tell which avatar this is." >&2
    echo "  Looked for AVATAR_NAME in $AVATAR_ROOT/harness/config; set MAILBOX_AVATAR to override." >&2
    exit 1
}
: "${MAILBOX_ROOT:=$AVATAR_ROOT/mail}"
: "${MAILBOX_REGISTRY:=$AVATAR_ROOT/tools/nostr-mailbox/registry.json}"
: "${MAILBOX_RELAYS:=$AVATAR_ROOT/tools/nostr-mailbox/relays.json}"

# Every call that touches the relay is bounded by this, because nak has no timeout
# of its own: a relay that accepts the connection and then says nothing leaves
# `nak req` waiting for an EOSE that never comes, and `nak event` waiting for an OK.
# Twenty seconds is far longer than a local relay needs and short enough that a
# wedged call is a message rather than a hung session.
: "${MAILBOX_RELAY_TIMEOUT:=20}"

die() { printf '\033[1;31mmailbox:\033[0m %s\n' "$*" >&2; exit 1; }
say() { printf '\033[1;34mmailbox:\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mmailbox:\033[0m %s\n' "$*" >&2; }

# ──────────────────────────────────────────────────────────── relays ──────────
# RELAY_NAMES[i] / RELAY_URLS[i], in order of preference (see WHICH RELAY above).
RELAY_NAMES=(); RELAY_URLS=(); RELAY_SOURCE=""
if [[ -n "${NOSTR_MAILBOX_RELAY:-}" ]]; then
    RELAY_NAMES=( override ); RELAY_URLS=( "$NOSTR_MAILBOX_RELAY" ); RELAY_SOURCE="\$NOSTR_MAILBOX_RELAY"
elif [[ -f "$MAILBOX_RELAYS" ]]; then
    # A broken relays.json is a hard stop, not a fallback to the default: guessing a
    # relay is how mail goes somewhere nobody reads.
    jq -e '(.relays | type == "array" and length > 0)
           and all(.relays[]; (.name | type == "string" and length > 0)
                          and (.url | type == "string" and test("^wss?://")))
           and ([.relays[].name] | length == (unique | length))' "$MAILBOX_RELAYS" >/dev/null 2>&1 \
        || die "$MAILBOX_RELAYS is not a usable relay list -- it needs {\"relays\": [{\"name\", \"url\": \"ws(s)://...\"}, ...]} with distinct names"
    while IFS=$'\t' read -r n u; do RELAY_NAMES+=( "$n" ); RELAY_URLS+=( "$u" ); done \
        < <(jq -r '.relays[] | [.name, .url] | @tsv' "$MAILBOX_RELAYS")
    RELAY_SOURCE="$MAILBOX_RELAYS"
else
    RELAY_NAMES=( local ); RELAY_URLS=( ws://nostr-relay:8080 ); RELAY_SOURCE="default (no $MAILBOX_RELAYS)"
fi

# ─────────────────────────────────────────────────────────────── nak ──────────
# Every call to nak lives here. It is the one dependency whose interface this
# script does not control, so `mailbox doctor` probes it rather than assuming --
# a wrong flag should say so on demand, not halfway through sending.

# Via stdin, not argv, for the same reason as NOSTR_SECRET_KEY below. printf is a
# bash builtin, so the key never becomes any process's arguments.
nak_pubkey() { printf %s "$1" | nak key public; }           # sec -> pubkey-hex


# nak takes the key from $NOSTR_SECRET_KEY, and that is the form to use: passing it
# as --sec would put the avatar's private key in the process argv, where anything
# that can read /proc in this container can see it. Exported only for nak's own
# children, and it is the same value already in this environment -- no new exposure,
# one less place it is visible.
export NOSTR_SECRET_KEY="${NOSTR_MAILBOX_NSEC:-}"

# The plaintext is an argument because nak reads it from nowhere else (stdin is
# ignored). Decrypt appends one newline, stripped so the body round-trips exactly.
#
# Deliberately NOT routed through nak_relay below: encrypting and decrypting are
# local operations that never open a socket, so bounding them would bound nothing
# and a 20s ceiling on a CPU-bound call is a timeout waiting to be mysterious.
nak_encrypt() { nak encrypt -p "$1" "$2"; }                 # <peer-hex> <plaintext>
nak_decrypt() { # <peer-hex> <ciphertext>
    local out; out="$(nak decrypt -p "$1" "$2"; printf x)" || return 1
    out="${out%x}"; printf '%s' "${out%$'\n'}"
}

# SIGINT rather than SIGTERM so nak closes the websocket on its way out; --kill-after
# covers it ignoring that. timeout exits 124 when it fires, which is the one rc worth
# naming -- every caller treats the rest as "nak failed".
#
# --auth on every relay call: a relay that demands NIP-42 sign-in (the gated relay,
# which is what lets the fabric sit on a public address) gets it, signed with the
# avatar's own key from $NOSTR_SECRET_KEY; a relay that never asks never sees it.
#
# A req never gets our stdin: see nak_sign below.
nak_relay() { # <event|req> <nak args...> <relay-url>
    local rc=0 verb="$1"; shift
    if [[ "$verb" == req ]]; then
        timeout --signal=INT --kill-after=5 "$MAILBOX_RELAY_TIMEOUT" nak req --auth "$@" </dev/null || rc=$?
    else
        timeout --signal=INT --kill-after=5 "$MAILBOX_RELAY_TIMEOUT" nak "$verb" --auth "$@" || rc=$?
    fi
    (( rc == 124 )) && printf '\033[1;31mmailbox:\033[0m relay %s did not answer within %ss\n' \
        "${*: -1}" "$MAILBOX_RELAY_TIMEOUT" >&2
    return "$rc"
}

# nak event READS STDIN whenever stdin is not a terminal: each line is taken as a
# template and signed and published as one more event, and an open pipe that never
# closes is waited on forever. So every signing call gets </dev/null. Without it, an
# ack sent from inside fetch's read loop swallowed the rest of the fetched events,
# and a send from a caller holding a pipe open waited on it until the timeout.
nak_sign() { nak event "$@" </dev/null; }                   # <event args...> -> signed event

# Signing is local and happens ONCE; only the signed event travels. So a fallback
# relay gets the very same event, with the same id -- if the default took it after
# all and only the answer was lost, the recipient sees one message, not two.
#
# Subject and from_name are no longer tags: the subject rides inside the
# ciphertext, and the sender's name is the registry's reading of the author key.
nak_sign_message() { # <ciphertext> <to-hex> [<reply-to-id>] [ack] -> signed event
    local args=( -k "$KIND_MESSAGE" --tag "p=$2" --tag "encrypted=nip44" )
    [[ -n "${3:-}" ]] && args+=( --tag "e=$3;;reply" )
    # Asking is a tag on the message, so the request travels with it and the
    # receiver needs no out-of-band knowledge of who wants a receipt.
    [[ "${4:-}" == ack ]] && args+=( --tag "ack=request" )
    nak_sign "${args[@]}" -c "$1"
}

nak_put() { printf '%s' "$1" | nak_relay event "$2" >/dev/null; }   # <signed-event> <relay-url>

# Which of our relays a contact reads, in OUR order. A contact whose entry names no
# relays is taken to read them all; the override is one relay for everything.
routes_to() { # <registry-name> -> relay URLs, one per line
    local want i
    [[ "${RELAY_NAMES[0]}" == override ]] && { printf '%s\n' "${RELAY_URLS[@]}"; return 0; }
    want="$(jq -r --arg n "$1" '(.[$n].relays // [])[]' "$MAILBOX_REGISTRY")"
    for i in "${!RELAY_URLS[@]}"; do
        [[ -z "$want" ]] || grep -qxF -- "${RELAY_NAMES[$i]}" <<<"$want" || continue
        printf '%s\n' "${RELAY_URLS[$i]}"
    done
}

# Default, then the next one, then the next: the first relay that takes it ends the
# send. No broadcast -- one copy on one relay the recipient reads is delivery.
publish_to() { # <registry-name> <signed-event> -> the URL that took it; rc 1 if none did
    local urls url rc
    urls="$(routes_to "$1")"
    [[ -n "$urls" ]] || { warn "none of our relays is one $1 reads (registry.json \"relays\")"; return 1; }
    while IFS= read -r url; do
        rc=0; nak_put "$2" "$url" 2>/dev/null || rc=$?
        (( rc == 0 )) && { printf '%s\n' "$url"; return 0; }
        warn "relay $url did not take it (nak exit $rc)"
    done <<<"$urls"
    return 1
}

# A deletion goes to every relay, since we do not record which one took the
# message. Its caller then asks every relay (nak_get) whether it still serves it.
nak_delete() { # <event-id>
    local ev url ok=0
    ev="$(nak_sign -k "$KIND_DELETION" --tag "e=$1" --tag "k=$KIND_MESSAGE" -c "unsent by $MAILBOX_AVATAR")" || return 1
    for url in "${RELAY_URLS[@]}"; do nak_put "$ev" "$url" 2>/dev/null && ok=1; done
    (( ok ))
}

# Unlike a fetch, this fails if ANY relay cannot be asked: it is the delete's proof,
# and a relay we could not ask may still be serving the message.
nak_get() { # <event-id> -> the event from any relay that still serves it, or nothing
    local url
    for url in "${RELAY_URLS[@]}"; do nak_relay req -i "$1" "$url" || return 1; done
}

# "+" is NIP-25's content for a positive reaction; the ack tag says WHICH of the
# two facts this is. k records the kind reacted to, as NIP-25 asks. It is routed
# like mail: to a relay the message's author reads.
nak_ack() { # <message-id> <message-author-hex> <delivered|read>
    local ev
    ev="$(nak_sign -k "$KIND_ACK" --tag "e=$1" --tag "p=$2" --tag "k=$KIND_MESSAGE" \
        --tag "ack=$3" -c "+")" || return 1
    publish_to "$(reg_name "$2")" "$ev" >/dev/null
}

# Reads go to EVERY relay: mail waits on whichever one its sender reached. A relay
# that cannot be read is a warning -- what it holds waits there for the next fetch --
# and the call fails only when none could, so "no mail" never hides "no relay".
read_all() { # <nak req args...> -> events from every relay, one per line
    local url ok=0
    for url in "${RELAY_URLS[@]}"; do
        if nak_relay req "$@" "$url"; then ok=1
        else warn "relay $url could not be read -- what it holds waits there for the next fetch"; fi
    done
    (( ok ))
}

nak_fetch_acks() { read_all -k "$KIND_ACK" --tag "p=$MY_PUBKEY"; }      # -> one ack event per line
nak_fetch()      { read_all -k "$KIND_MESSAGE" --tag "p=$MY_PUBKEY"; }  # -> one event per line

nak_verify() { nak verify 2>/dev/null; }                    # event JSON on stdin

# ──────────────────────────────────────────────────────── registry ────────────
reg_npub() { jq -r --arg n "$1" '.[$n].npub // empty' "$MAILBOX_REGISTRY"; }
reg_name() { jq -r --arg k "$1" 'to_entries[] | select(.value.pubkey_hex==$k) | .key' \
                "$MAILBOX_REGISTRY" | head -1; }

[[ -f "$MAILBOX_REGISTRY" ]] || die "no registry.json at $MAILBOX_REGISTRY"
MY_HEX="$(jq -r --arg n "$MAILBOX_AVATAR" '.[$n].pubkey_hex // empty' "$MAILBOX_REGISTRY")"
[[ -n "$MY_HEX" ]] || die "$MAILBOX_AVATAR has no entry in $MAILBOX_REGISTRY"
MY_PUBKEY="$MY_HEX"

# ──────────────────────────────────────────────────────── maildir ─────────────
INBOX="$MAILBOX_ROOT"
SENT="$MAILBOX_ROOT/.Sent"
# Acks are not mail and must not arrive in the inbox as if they were -- nobody
# wants to read a tick. They are kept beside it, and the FILENAME carries both
# ids: its own (so re-fetching dedupes through md_has, like everything else) and
# the message it acks, glued with a dash rather than a dot so `md_has <msg-id>`
# cannot match an ack and report the message itself as already held.
ACKS="$MAILBOX_ROOT/.Acks"

md_init() { mkdir -p "$INBOX"/{tmp,new,cur} "$SENT"/{tmp,new,cur} "$ACKS"/{tmp,cur}; }

# A message is already claimed if any file names its event id. The archive is the
# index; there is nothing else to consult.
md_has() { find "$MAILBOX_ROOT" -type f -name "*.$1.*" -print -quit 2>/dev/null | grep -q .; }

# Maildir requires the filename to be unique and forbids readers from parsing it.
# The event id makes it unique for free AND makes dedupe a directory listing.
md_name() { printf '%s.%s.%s' "$2" "$1" "$MAILBOX_AVATAR"; }   # <event-id> <created_at>

# Deliver: write into tmp/, then rename into new/ or cur/. The rename is atomic on
# every POSIX filesystem, which is the whole reason Maildir exists -- no locking,
# and a reader never sees a half-written message.
md_deliver() { # <folder> <event-id> <created_at> <flags> <new|cur> ; message on stdin
    local folder="$1" name; name="$(md_name "$2" "$3")"
    [[ -n "$4" ]] && name="$name:2,$4"
    cat > "$folder/tmp/$name"
    mv "$folder/tmp/$name" "$folder/${5:-new}/$name"
    printf '%s\n' "$folder/${5:-new}/$name"
}

md_find() { find "$INBOX/new" "$INBOX/cur" -type f -name "*.$1.*" 2>/dev/null | head -1; }

# Seen is a rename, not a database write: new/<name> -> cur/<name>:2,S
md_mark_seen() {
    local f="$1" base; base="$(basename "$f")"
    [[ "$f" == */new/* ]] || return 0
    mv "$f" "$INBOX/cur/${base}:2,S"
}

# Replied is a Maildir flag, recorded by renaming -- no database. Idempotent:
# replying twice must not mv the file onto itself. Flags are stripped from the
# BASENAME (a path may legitimately contain a colon), then :2,SR reapplied.
md_mark_replied() {
    local f="$1" base target; base="$(basename "$f")"
    target="$INBOX/cur/${base%%:*}:2,SR"
    # -ef (same device+inode), not string ==, so the guard holds even if the
    # caller passes a path spelled differently for the same file.
    [[ "$f" -ef "$target" ]] || mv "$f" "$target"
}

# ─────────────────────────────────────────────────────────── acks ─────────────
# Acks are AUTOMATIC, and that is the whole design. There is no daemon here, so
# anything that depends on an agent remembering to send an ack will not be sent:
# the only reliable moments are the commands that already run. `fetch` is the
# honest moment for "delivered" (the message is on this avatar's disk) and `read`
# for "displayed". Neither claims more than it knows -- read means the bytes were
# printed, not that anyone understood or acted on them.
#
# An ack never fails the thing it is acking. A message that arrived has arrived
# whether or not the receipt got out, and losing the mail because the receipt
# failed would be the worse outcome by far -- so this warns and returns 0.
ack_requested() { # event JSON on stdin
    jq -e '.tags[] | select(.[0]=="ack" and .[1]=="request")' >/dev/null 2>&1
}

ack_publish() { # <message-id> <message-author-hex> <delivered|read>
    [[ "$2" == "$MY_HEX" ]] && return 0        # no receipts to ourselves
    if ! nak_ack "$1" "$2" "$3" >/dev/null 2>&1; then
        printf '\033[1;31mmailbox:\033[0m could not publish the %s ack for %s -- the mail is fine, the receipt is not\n' \
            "$3" "${1:0:8}" >&2
    fi
    return 0
}

# What the sender knows about one message it sent. read outranks delivered: a
# message that was read was necessarily delivered, and one tick is enough.
ack_state() { # <message-id> -> "" | delivered | read
    local id="$1"
    find "$ACKS/cur" -type f -name "*.ack-$id-read.*"      -print -quit 2>/dev/null | grep -q . && { echo read; return; }
    find "$ACKS/cur" -type f -name "*.ack-$id-delivered.*" -print -quit 2>/dev/null | grep -q . && { echo delivered; return; }
    echo ""
}

# Claim acks addressed to us. Fails closed on the same three questions the mail
# path asks, plus one only a sender can ask: an ack is only believable from the
# avatar the message was actually ADDRESSED to. Without that check any registry
# member could tick someone else's message, and a false "delivered" is worse
# than none -- it is the sender believing a message landed when it did not.
ack_claim() { # -> count on stdout
    local ev id msg state author who sent_to f n=0
    while IFS= read -r ev; do
        [[ -n "$ev" ]] || continue
        id="$(jq -r '.id // empty' <<<"$ev")"; [[ -n "$id" ]] || continue
        md_has "$id" && continue
        printf '%s' "$ev" | nak_verify || continue
        author="$(jq -r '.pubkey' <<<"$ev")"
        who="$(reg_name "$author")"; [[ -n "$who" ]] || continue
        msg="$(jq -r '(.tags[] | select(.[0]=="e") | .[1]) // ""' <<<"$ev" | head -1)"
        state="$(jq -r '(.tags[] | select(.[0]=="ack") | .[1]) // ""' <<<"$ev" | head -1)"
        [[ -n "$msg" && ( "$state" == delivered || "$state" == read ) ]] || continue
        f="$(find "$SENT/cur" -type f -name "*.$msg.*" 2>/dev/null | head -1)"
        [[ -n "$f" ]] || continue                       # not a message we sent
        sent_to="$(hdr "$f" To | cut -d' ' -f1)"
        [[ "$sent_to" == "$who" ]] || continue          # not from the addressee
        printf '%s' "$ev" > "$ACKS/tmp/x.$$"
        mv "$ACKS/tmp/x.$$" "$ACKS/cur/$(jq -r '.created_at' <<<"$ev").$id.ack-$msg-$state.$MAILBOX_AVATAR"
        n=$((n+1))
    done < <(nak_fetch_acks)
    printf '%s' "$n"
}

# ─────────────────────────────────────────────────────── envelope ─────────────
# seal: subject + body -> NIP-44 ciphertext for one recipient. The plaintext is a
# small JSON object so the subject is hidden along with the body.
seal() { # <to-hex> <subject> <body>
    local pt; pt="$(jq -nc --arg s "$2" --arg b "$3" '{subject: $s, body: $b}')"
    (( $(printf '%s' "$pt" | wc -c) <= NIP44_MAX )) \
        || die "refusing to send: the message is over NIP-44's $NIP44_MAX-byte limit -- share the file and send its location"
    nak_encrypt "$1" "$pt"
}

# open: an event as fetched -> the same event with the plaintext body in .content
# and the subject back as a tag, so render() needs no second path. NIP-44 keys are
# symmetric, so we decrypt our own sent copy with the recipient's key. A plaintext
# event (sent by a mailbox older than this one) passes through unchanged.
open_event() { # event JSON on stdin -> event JSON on stdout; fails if it cannot decrypt
    local ev peer pt; ev="$(cat)"
    if ! jq -e '.tags[] | select(.[0]=="encrypted" and .[1]=="nip44")' <<<"$ev" >/dev/null; then
        printf '%s' "$ev"; return 0
    fi
    peer="$(jq -r '.pubkey' <<<"$ev")"
    [[ "$peer" == "$MY_HEX" ]] && peer="$(jq -r '(.tags[] | select(.[0]=="p") | .[1]) // ""' <<<"$ev" | head -1)"
    pt="$(nak_decrypt "$peer" "$(jq -r '.content' <<<"$ev")" 2>/dev/null)" || return 1
    jq -e 'has("subject") and has("body")' <<<"$pt" >/dev/null 2>&1 || return 1
    jq -c --argjson pt "$pt" '.content = $pt.body | .tags += [["subject", $pt.subject]]' <<<"$ev"
}

# ────────────────────────────────────────────────────── rfc 5322 ──────────────
# The envelope is real mail headers, so the archive is readable by anything that
# reads mail and the Nostr specifics ride along as X- headers. Threading is free:
# a Nostr "e" tag IS In-Reply-To.
render() { # event JSON on stdin -> RFC 5322 on stdout
    local ev; ev="$(cat)"
    local id created content subject from_hex from_name reply_to to_hex to_name
    id=$(jq -r '.id' <<<"$ev")
    created=$(jq -r '.created_at' <<<"$ev")
    from_hex=$(jq -r '.pubkey' <<<"$ev")
    content=$(jq -r '.content' <<<"$ev")
    subject=$(jq -r '(.tags[] | select(.[0]=="subject") | .[1]) // ""' <<<"$ev" | head -1)
    from_name=$(jq -r '(.tags[] | select(.[0]=="from_name") | .[1]) // ""' <<<"$ev" | head -1)
    reply_to=$(jq -r '(.tags[] | select(.[0]=="e") | .[1]) // ""' <<<"$ev" | head -1)
    # The recipient is the "p" tag, not necessarily us: render() archives our own
    # outgoing mail too, and there the addressee is the other avatar.
    to_hex=$(jq -r '(.tags[] | select(.[0]=="p") | .[1]) // ""' <<<"$ev" | head -1)
    to_name="$(reg_name "$to_hex")"
    [[ -n "$to_name" ]] || to_name="$MAILBOX_AVATAR"
    [[ -n "$from_name" ]] || from_name="$(reg_name "$from_hex")"
    [[ -n "$from_name" ]] || from_name="unknown"

    printf 'Message-ID: <%s@nostr>\n' "$id"
    printf 'Date: %s\n' "$(date -u -R -d "@$created")"
    printf 'From: %s <%s@nostr>\n' "$from_name" "$(reg_npub "$from_name" || echo "$from_hex")"
    printf 'To: %s <%s@nostr>\n' "$to_name" "$(reg_npub "$to_name")"
    printf 'Subject: %s\n' "$subject"
    [[ -n "$reply_to" ]] && printf 'In-Reply-To: <%s@nostr>\n' "$reply_to"
    printf 'X-Nostr-Event-Id: %s\n' "$id"
    printf 'X-Nostr-Pubkey: %s\n' "$from_hex"
    printf 'X-Nostr-Kind: %s\n' "$(jq -r '.kind' <<<"$ev")"
    # The archive is the only record, so a request that is not written here is a
    # request `mailbox read` can never see: it reads the file, not the event.
    printf '%s' "$ev" | ack_requested && printf 'X-Nostr-Ack-Request: yes\n'
    printf 'X-Nostr-Sig: %s\n' "$(jq -r '.sig' <<<"$ev")"
    printf 'X-Nostr-Encryption: %s\n' \
        "$(jq -r '(.tags[] | select(.[0]=="encrypted") | .[1]) // "none"' <<<"$ev" | head -1)"
    printf 'MIME-Version: 1.0\n'
    printf 'Content-Type: text/markdown; charset=utf-8\n'
    printf '\n%s\n' "$content"
}

hdr() { sed -n "/^$2:/{s/^$2:[[:space:]]*//;p;q}" "$1"; }

# ───────────────────────────────────────────────────────── commands ───────────
# The body comes from an inline argument or --body-file, never from stdin. Stdin
# was the one source whose EOF the caller controlled, so it could hang (stream
# left open with no EOF) or sign an empty event (instant EOF) -- both removed by
# not reading it. An inline argument is argv: it cannot hang and cannot EOF. The
# guard below is on the resolved BODY, not the file, so an empty or
# whitespace-only body is refused whichever way it arrived and is never signed.
require_body() { # <body> -- dies if empty or whitespace-only
    [[ -n "${1//[[:space:]]/}" ]] || die "refusing to send: the body is empty or only whitespace"
}

cmd_doctor() {
    local ok=0
    command -v nak >/dev/null && say "nak: $(nak --version 2>&1 | head -1)" \
        || { printf '  MISSING: nak is not installed (add it to the harness image)\n'; ok=1; }
    command -v jq >/dev/null || { printf '  MISSING: jq\n'; ok=1; }
    if [[ -z "${NOSTR_MAILBOX_NSEC:-}" ]]; then
        printf '  MISSING: NOSTR_MAILBOX_NSEC is not in the environment\n'; ok=1
    elif command -v nak >/dev/null; then
        # The assertion the old container made at startup: the key you were given
        # must be the identity you claim. A mismatch is silent misdelivery.
        local derived; derived="$(nak_pubkey "$NOSTR_MAILBOX_NSEC" 2>/dev/null || true)"
        if [[ "$derived" == "$MY_HEX" ]]; then
            say "key: derives $MY_HEX -- matches registry entry for $MAILBOX_AVATAR"
            local ct; ct="$(nak_encrypt "$MY_HEX" "doctor" 2>/dev/null || true)"
            if [[ -n "$ct" && "$(nak_decrypt "$MY_HEX" "$ct" 2>/dev/null)" == "doctor" ]]; then
                say "encryption: NIP-44 round trip ok"
            else
                printf '  BROKEN: NIP-44 encrypt/decrypt does not round-trip with this nak\n'; ok=1
            fi
        else
            printf '  WRONG KEY: derives %s, registry says %s\n' "${derived:-<nak failed>}" "$MY_HEX"; ok=1
        fi
    fi
    say "relays:   from $RELAY_SOURCE, in order of preference"
    local i c
    for i in "${!RELAY_URLS[@]}"; do printf '            %s  %s\n' "${RELAY_NAMES[$i]}" "${RELAY_URLS[$i]}"; done
    # A contact we share no relay with is mail that can never arrive -- say so now.
    for c in $(jq -r 'keys[]' "$MAILBOX_REGISTRY"); do
        [[ "$c" == "$MAILBOX_AVATAR" || -n "$(routes_to "$c")" ]] && continue
        printf '  UNREACHABLE: %s reads none of these relays (registry.json "relays": %s)\n' \
            "$c" "$(jq -c --arg n "$c" '.[$n].relays' "$MAILBOX_REGISTRY")"; ok=1
    done
    say "maildir:  $MAILBOX_ROOT"
    say "contacts: $(jq -r 'keys | length' "$MAILBOX_REGISTRY") in $MAILBOX_REGISTRY"
    md_init && say "maildir is writable"
    return $ok
}

cmd_contacts() { jq -r 'to_entries[] | "  \(.key)  \(.value.npub)"' "$MAILBOX_REGISTRY"; }

cmd_fetch() {
    md_init
    # The events are read from a file rather than straight from `nak_fetch`, because a
    # process substitution throws its exit status away: a fetch that timed out would
    # feed the loop nothing and report "claimed 0 new", which is exactly what a healthy
    # empty mailbox prints. A failed fetch has to be distinguishable from no mail.
    local raw rc=0
    raw="$(mktemp "${TMPDIR:-/tmp}/mailbox-fetch.XXXXXX")"
    nak_fetch > "$raw" || rc=$?
    if (( rc != 0 )); then
        rm -f "$raw"
        die "fetch failed (nak exit $rc) -- nothing was claimed and the maildir is unchanged"
    fi

    local n=0 dup=0 bad=0 ev id created opened
    reject() { bad=$((bad+1)); printf '  REJECTED %s: %s\n' "${id:0:8}" "$1" >&2; }
    while IFS= read -r ev; do
        [[ -n "$ev" ]] || continue
        id=$(jq -r '.id // empty' <<<"$ev"); [[ -n "$id" ]] || continue
        if md_has "$id"; then dup=$((dup+1)); continue; fi
        # Fail closed, three times. An event that does not verify is not archived --
        # the relay's allowlist is not a substitute for checking the signature
        # ourselves. A valid signature only proves SOME key signed it, so the key
        # must also be one registry.json names. And mail we cannot decrypt is
        # reported rather than archived as ciphertext.
        if ! printf '%s' "$ev" | nak_verify; then reject "signature does not verify"; continue; fi
        if [[ -z "$(reg_name "$(jq -r '.pubkey' <<<"$ev")")" ]]; then reject "sender is not in the registry"; continue; fi
        if ! opened="$(printf '%s' "$ev" | open_event)"; then reject "cannot decrypt"; continue; fi
        created=$(jq -r '.created_at' <<<"$ev")
        printf '%s' "$opened" | render | md_deliver "$INBOX" "$id" "$created" "" new >/dev/null
        n=$((n+1))
        # Delivered, meaning: it is on this avatar's disk. Acked after the archive
        # write, never before -- a receipt for a message we then failed to keep
        # would be a lie, and the order is the only thing that guarantees it.
        printf '%s' "$ev" | ack_requested && ack_publish "$id" "$(jq -r '.pubkey' <<<"$ev")" delivered
    done < "$raw"
    rm -f "$raw"
    local acked; acked="$(ack_claim)"
    say "claimed $n new, skipped $dup already held$( ((bad)) && printf ', REJECTED %d unverified' "$bad")$( (( acked )) && printf ', %d ack(s) for mail you sent' "$acked")"
}

cmd_list() {
    local dirs=("$INBOX/new")
    [[ "${1:-}" == "--all" ]] && dirs+=("$INBOX/cur" "$SENT/cur")
    local f id state label
    find "${dirs[@]}" -type f 2>/dev/null | sort -r | while read -r f; do
        id="$(hdr "$f" X-Nostr-Event-Id)"
        # For mail WE sent, the useful state is not whether we have read it -- we
        # wrote it -- but whether the other end has. An asked-for ack that has
        # not come back is worth seeing as "sent", not as silence.
        if [[ "$f" == */.Sent/* ]]; then
            state="$(ack_state "$id")"
            if [[ -n "$state" ]]; then label="$state"
            elif [[ "$(hdr "$f" X-Nostr-Ack-Request)" == yes ]]; then label="awaiting ack"
            else label="sent"; fi
        else
            label="$([[ "$f" == */new/* ]] && echo unread || echo seen)"
        fi
        printf '  %-13s %-28s %s\n' "$label" "$(hdr "$f" From | cut -d' ' -f1)" "$(hdr "$f" Subject)"
        printf '  %-13s %s\n' '' "$id"
    done
}

cmd_read() {
    local f; f="$(md_find "${1:?usage: mailbox read <event-id>}")"
    [[ -n "$f" ]] || die "no message with id ${1}"
    # Whether this is the FIRST read has to be decided before md_mark_seen moves
    # the file, since that move is what records it. Re-reading is not a new fact
    # and must not publish a second receipt.
    # Both of these are read BEFORE md_mark_seen, because that moves the file:
    # whether this is the first read, and the headers the receipt is built from.
    # Asking $f afterwards asks a path that no longer exists, and the receipt
    # silently never goes out.
    local first=0 want="" msg_id="" author=""
    [[ "$f" == */new/* ]] && first=1
    want="$(hdr "$f" X-Nostr-Ack-Request)"
    msg_id="$(hdr "$f" X-Nostr-Event-Id)"
    author="$(hdr "$f" X-Nostr-Pubkey)"
    cat "$f"
    md_mark_seen "$f"
    (( first )) && [[ "$want" == yes ]] && ack_publish "$msg_id" "$author" read
    return 0
}

cmd_send() {
    [[ $# -ge 1 ]] || die "usage: mailbox send <avatar> --subject S [--ack] [--body-file F | <inline body>]"
    local to="$1"; shift
    local subject="" reply="" body_file="" ack=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --subject)   subject="$2"; shift 2 ;;
            --reply)     reply="$2"; shift 2 ;;
            --ack)       ack=ack; shift ;;
            --body-file) body_file="$2"; shift 2 ;;
            *)           break ;;
        esac
    done
    # Body from --body-file OR one inline argument, never both, never stdin.
    local body
    if [[ -n "$body_file" ]]; then
        [[ $# -eq 0 ]]        || die "give --body-file OR an inline body, not both"
        [[ -f "$body_file" ]] || die "body file not found: $body_file"
        body="$(cat "$body_file")"
    elif [[ $# -gt 0 ]]; then
        [[ $# -eq 1 ]] || die "inline body must be a single quoted argument (or use --body-file F)"
        body="$1"
    else
        die "no body -- pass an inline body or --body-file F (for a long body: mkdir -p /project/tmp first -- nothing creates it, and it is gitignored)"
    fi
    require_body "$body"
    local to_hex
    to_hex="$(jq -r --arg n "$to" '.[$n].pubkey_hex // empty' "$MAILBOX_REGISTRY")"
    [[ -n "$to_hex" ]] || die "unknown recipient $to -- not in the registry; try: mailbox contacts"
    md_init
    local sealed ev
    sealed="$(seal "$to_hex" "$subject" "$body")" || die "encryption failed -- nothing was sent"
    ev="$(nak_sign_message "$sealed" "$to_hex" "$reply" "$ack")" || die "signing failed -- nothing was sent"
    # nak exiting 0 is not proof that it produced an event. It has been seen to exit
    # clean having printed nothing at all, and an unchecked empty result was ARCHIVED:
    # two empty fields make the filename "..<avatar>:2,S", a dotfile that `ls .Sent/cur`
    # does not show, under a "sent to <avatar> ()" line with an empty id. So the
    # signed event is checked before it goes anywhere.
    local id created via
    id="$(jq -r '.id // empty' <<<"$ev" 2>/dev/null || true)"
    created="$(jq -r '.created_at // empty' <<<"$ev" 2>/dev/null || true)"
    [[ "$id" =~ ^[0-9a-f]{64}$ && "$created" =~ ^[0-9]+$ ]] || die \
        "signing printed no event -- treat it as NOT SENT and retry; nothing was archived"
    # A relay's OK is the proof of sending, and nak exits non-zero without one.
    via="$(publish_to "$to" "$ev")" || die "no relay took it -- nothing was sent and nothing was archived"
    # Only then archive, and archive the DECRYPTED copy: $ev's content is ciphertext
    # now, so writing it to .Sent would store a message its own sender cannot read.
    # Decrypting what was actually published also means a message that cannot be
    # opened again fails loudly here rather than at the reader.
    local opened
    opened="$(printf '%s' "$ev" | open_event)" || die "sent $id, but could not decrypt it back for the archive"
    printf '%s' "$opened" | render | md_deliver "$SENT" "$id" "$created" "S" cur >/dev/null
    say "sent to $to  ($id)  via $via"
}

cmd_reply() {
    local f; f="$(md_find "${1:?usage: mailbox reply <event-id> [--body-file F | <inline body>]}")"
    [[ -n "$f" ]] || die "no message with id ${1}"
    local parent peer subject
    parent="$(hdr "$f" X-Nostr-Event-Id)"
    peer="$(hdr "$f" From | cut -d' ' -f1)"
    subject="$(hdr "$f" Subject)"
    [[ "$subject" == Re:* ]] || subject="Re: $subject"
    shift
    cmd_send "$peer" --subject "$subject" --reply "$parent" "$@"
    md_mark_replied "$f"
}

# Unsend. Only the author can delete an event, so only mail in .Sent qualifies;
# a recipient who already fetched it keeps their copy -- this is not
# delete-on-read. A relay may ignore NIP-09, so we ask it for the event
# afterwards and say plainly if it is still there.
cmd_delete() {
    local id="${1:?usage: mailbox delete <event-id>}" f
    f="$(find "$SENT/cur" -type f -name "*.$id.*" 2>/dev/null | head -1)"
    [[ -n "$f" ]] || die "no sent message with id $id -- you can only unsend mail you sent (mailbox list --all)"
    nak_delete "$id" >/dev/null || die "the deletion request did not publish -- nothing changed"
    # An empty answer means gone only if the query itself succeeded: a relay that
    # could not be asked also answers with nothing, and must not read as success.
    local served
    served="$(nak_get "$id" 2>/dev/null)" \
        || die "deletion requested, but the relay could not be asked whether it still serves $id -- unconfirmed; rerun mailbox delete"
    if [[ -n "$served" ]]; then
        die "deletion requested, but the relay STILL SERVES $id -- it has not honoured NIP-09"
    fi
    # Maildir's T flag: trashed. The archive keeps the copy and records the unsend.
    local base target; base="$(basename "$f")"; target="$SENT/cur/${base%%:*}:2,ST"
    [[ "$f" -ef "$target" ]] || mv "$f" "$target"
    say "unsent $id -- the relay no longer serves it; copies already fetched remain"
}

# When sourced (e.g. by tests) define the functions but do not dispatch.
[[ "${BASH_SOURCE[0]}" == "${0}" ]] || return 0

case "${1:-doctor}" in
    doctor)   shift; cmd_doctor "$@" ;;
    contacts) shift; cmd_contacts "$@" ;;
    fetch)    shift; cmd_fetch "$@" ;;
    list)     shift; cmd_list "$@" ;;
    read)     shift; cmd_read "$@" ;;
    send)     shift; cmd_send "$@" ;;
    reply)    shift; cmd_reply "$@" ;;
    delete)   shift; cmd_delete "$@" ;;
    -h|--help|help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command '$1' (doctor|contacts|fetch|list|read|send|reply|delete)" ;;
esac
