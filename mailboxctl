#!/usr/bin/env bash
# mailboxctl -- run this avatar's mailbox as its own compose project.
#
#   ./mailboxctl build     build the image (explicit; `up` never builds)
#   ./mailboxctl up        start the mailbox
#   ./mailboxctl down      stop it
#   ./mailboxctl logs      follow it
#   ./mailboxctl status    is it running, and what is it attached to
#
# Deliberately NOT part of the avatar's stack. `./launch-agent up` folds every
# tools/*/docker-compose.yml into the agent's compose invocation; this component's
# file is called mailbox.compose.yml so it cannot be folded, and therefore cannot
# stop the agent from booting. See the header of that file.
#
# Host-side: the agent has no docker. Run it from the avatar directory's
# tools/nostr-mailbox/.
set -euo pipefail

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
AVATAR_ROOT="$(cd -- "$HERE/../.." && pwd)"
COMPOSE_FILE="$HERE/mailbox.compose.yml"

die() { printf '\033[1;31m[mailbox]\033[0m %s\n' "$*" >&2; exit 1; }
log() { printf '\033[1;34m[mailbox]\033[0m %s\n' "$*"; }

[[ -f "$COMPOSE_FILE" ]] || die "no mailbox.compose.yml beside this script"

# Identity comes from the avatar's own config, never from the directory name:
# a directory name, an AVATAR_NAME and a git remote are all allowed to disagree.
[[ -f "$AVATAR_ROOT/harness/config" ]] || die "no harness/config at $AVATAR_ROOT -- is this inside an avatar?"
AVATAR_NAME="$(sed -n 's/^[[:space:]]*AVATAR_NAME=//p' "$AVATAR_ROOT/harness/config" | head -1 | tr -d "\"'")"
[[ -n "$AVATAR_NAME" ]] || die "AVATAR_NAME is not set in $AVATAR_ROOT/harness/config"

export MAILBOX_AVATAR="${MAILBOX_AVATAR:-$AVATAR_NAME}"
export AGENT_NETWORK="${AGENT_NETWORK:-$AVATAR_NAME}"
export MAILBOX_INBOX_HOST_PATH="$AVATAR_ROOT/inbox"
export MAILBOX_OUTBOX_HOST_PATH="$AVATAR_ROOT/outbox"
export MAILBOX_REGISTRY_HOST_PATH="$HERE/registry.json"
export HOST_UID="${HOST_UID:-$(id -u)}"
export HOST_GID="${HOST_GID:-$(id -g)}"
export MAILBOX_IMAGE="${MAILBOX_IMAGE:-nunet-tools/nostr-mailbox:go1.22-uid$HOST_UID}"

# One compose project per avatar's mailbox, separate from the avatar's own.
COMPOSE=( docker compose -p "mailbox-$MAILBOX_AVATAR" -f "$COMPOSE_FILE" )

# The signing key is resolved HERE and handed to the container, and nowhere else.
# It must never go through the harness's SANDBOX_SECRETS: that injects every entry
# into the AGENT's environment, which would leave this avatar's private key
# readable by the LLM for a whole session. The agent gets MAILBOX_API_TOKEN only.
load_secrets() {
    command -v pass >/dev/null || die "'pass' is not installed on this host"
    # Same layout scripts/mint-avatar-keys writes, and the same PASS_PREFIX knob,
    # so the minting side and the running side cannot drift apart.
    : "${PASS_PREFIX:=nunet/avatars}"
    : "${MAILBOX_NSEC_PASS_PATH:=$PASS_PREFIX/$MAILBOX_AVATAR/nostr-nsec}"
    : "${MAILBOX_TOKEN_PASS_PATH:=$PASS_PREFIX/$MAILBOX_AVATAR/mailbox-api-token}"
    NOSTR_MAILBOX_NSEC="$(pass show "$MAILBOX_NSEC_PASS_PATH" 2>/dev/null)" \
        || die "cannot read the key at pass:$MAILBOX_NSEC_PASS_PATH (override with MAILBOX_NSEC_PASS_PATH)"
    MAILBOX_API_TOKEN="$(pass show "$MAILBOX_TOKEN_PASS_PATH" 2>/dev/null)" \
        || die "cannot read the token at pass:$MAILBOX_TOKEN_PASS_PATH (override with MAILBOX_TOKEN_PASS_PATH)"
    [[ -n "$NOSTR_MAILBOX_NSEC" && -n "$MAILBOX_API_TOKEN" ]] || die "an entry in pass is empty"
    export NOSTR_MAILBOX_NSEC MAILBOX_API_TOKEN
}

# Both networks belong to someone else. Say which one is missing and who owns it,
# rather than letting compose report an id nobody recognises.
require_network() {
    docker network inspect "$1" >/dev/null 2>&1 || die "docker network '$1' does not exist -- $2"
}

case "${1:-status}" in
    build)
        log "building $MAILBOX_IMAGE"
        docker build -t "$MAILBOX_IMAGE" \
            --build-arg "MAILBOX_UID=$HOST_UID" --build-arg "MAILBOX_GID=$HOST_GID" "$HERE" ;;
    up)
        docker image inspect "$MAILBOX_IMAGE" >/dev/null 2>&1 \
            || die "image $MAILBOX_IMAGE is not built yet -- ./mailboxctl build"
        require_network "$AGENT_NETWORK" "it is the avatar's own network; start the avatar first (./launch-agent up)"
        require_network "${MAILBOX_RELAY_NETWORK:-nostr-mailbox-net}" "it belongs to the tools/nostr-relay component; bring the relay up first"
        [[ -f "$MAILBOX_REGISTRY_HOST_PATH" ]] || die "no registry.json beside this script -- scripts/build-registry generates it"
        load_secrets
        log "starting mailbox-$MAILBOX_AVATAR on $AGENT_NETWORK + ${MAILBOX_RELAY_NETWORK:-nostr-mailbox-net}"
        "${COMPOSE[@]}" up -d
        "${COMPOSE[@]}" ps ;;
    down)
        # No secrets needed to stop: compose only has to identify the project.
        NOSTR_MAILBOX_NSEC=- MAILBOX_API_TOKEN=- "${COMPOSE[@]}" down ;;
    logs)
        NOSTR_MAILBOX_NSEC=- MAILBOX_API_TOKEN=- "${COMPOSE[@]}" logs -f mailbox ;;
    status)
        printf '\n  avatar:   %s\n  image:    %s\n  networks: %s + %s\n\n' \
            "$MAILBOX_AVATAR" "$MAILBOX_IMAGE" "$AGENT_NETWORK" "${MAILBOX_RELAY_NETWORK:-nostr-mailbox-net}"
        docker ps --filter "name=mailbox-$MAILBOX_AVATAR" \
            --format '  {{.Names}}  {{.Status}}' | grep . || echo "  not running"
        echo "" ;;
    -h|--help|help)
        sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown subcommand '${1}' (build|up|down|logs|status)" ;;
esac
